# Линии: дороги, грунт, тропы, велосипедное, маршруты, железная дорога, вода.
#
# Как устроено:
#   1. Сначала каждой линии назначается класс (тег gm:cls), типы не выдаются.
#   2. Потом класс превращается в тип Garmin — свой для каждого диапазона
#      разрешений, потому что толщина линии в TYP одна на тип и от масштаба
#      не зависит. Четыре ступени толщин:
#        0x10c–0x10f SS  разрешение 24      экран 4, вплотную
#        0x110–0x113 SS  разрешение 23      экран 3, крупно
#        0x114–0x117 SS  разрешение 22      экран 2, окрестности
#        0x118–0x11b SS  разрешение 18–21   экран 1, обзор
#      В каждой четвёрке по слою: тоннели, дороги, мосты, накладки
#      (0x10c тоннели, 0x10d дороги, 0x10e мосты, 0x10f накладки и так далее).
#      SS — место в порядке отрисовки (больше = выше), одинаковое во всех
#      ступенях. 0x11cSS — линии, одинаковые на всех масштабах.
#      Номера выше 0x120xx занимать нельзя: Edge 1060 такие линии не рисует
#      (проверено на приборе, см. typ/make_typ.py).
#      Таблица типов, цветов и толщин — в typ/make_typ.py.

# ---------------------------------------------------------------------------
# 1. Классы дорог
# ---------------------------------------------------------------------------

# Площадные объекты рисуются в polygons
highway=* & area=yes { set gm:cls=none }

# Зелёное — «нельзя вообще»: автомагистрали, дороги для автомобилей
# (motorroad=yes) и большие дороги с bicycle=no. Обычные улицы с bicycle=no
# зелёными не делаем — они идут в «проезд запрещён» ниже.
highway=* & motorroad=yes { set gm:ban=yes }
bicycle=no & (highway=trunk | highway=trunk_link | highway=primary | highway=primary_link | highway=secondary | highway=secondary_link)
    { set gm:ban=yes }

highway=motorway      & gm:cls!=* { set gm:cls=green_wide }
highway=motorway_link & gm:cls!=* { set gm:cls=green_link }

gm:ban=yes & gm:cls!=* & (highway=trunk | highway=primary | highway=secondary)
    { set gm:cls=green_wide }
gm:ban=yes & gm:cls!=* & (highway=trunk_link | highway=primary_link | highway=secondary_link | highway=tertiary | highway=tertiary_link | highway=unclassified | highway=residential | highway=living_street | highway=service | highway=road)
    { set gm:cls=green_link }

# Проезд запрещён: местные дороги с access=no/private (если велосипедам
# явно не разрешено) или с bicycle=no.
(access=no | access=private) & gm:cls!=* & bicycle!=yes & bicycle!=designated & bicycle!=permissive
  & (highway=tertiary | highway=tertiary_link | highway=unclassified | highway=residential | highway=living_street | highway=service | highway=road)
    { set gm:cls=noaccess }
bicycle=no & gm:cls!=*
  & (highway=tertiary | highway=tertiary_link | highway=unclassified | highway=residential | highway=living_street | highway=service | highway=road)
    { set gm:cls=noaccess }

# Дороги по классам
gm:cls!=* & (highway=trunk | highway=trunk_link | highway=primary | highway=primary_link)
    { set gm:cls=primary }
gm:cls!=* & (highway=secondary | highway=secondary_link)
    { set gm:cls=secondary }
gm:cls!=* & (highway=tertiary | highway=tertiary_link | highway=unclassified)
    { set gm:cls=tertiary }
gm:cls!=* & (highway=residential | highway=living_street | highway=service | highway=road)
    { set gm:cls=street }

highway=pedestrian & gm:cls!=* { set gm:cls=pedestrian }
highway=cycleway   & gm:cls!=* { set gm:cls=cycleway }
highway=steps      & gm:cls!=* { set gm:cls=steps }

# --- Грунт и тропы ---

# Тротуары и переходы не показываем
highway=footway & (footway=sidewalk | footway=crossing | footway=traffic_island | footway=access_aisle)
    { set gm:cls=none }

# Велодорожка: path/footway, предназначенные велосипедам
(highway=path | highway=footway) & bicycle=designated & gm:cls!=* { set gm:cls=cycleway }

# Асфальтовая дорожка: твёрдое покрытие важнее класса
(highway=track | highway=path | highway=footway) & gm:cls!=*
  & (surface=asphalt | surface=paved | surface=concrete | surface=concrete:plates | surface=concrete:lanes | surface=paving_stones)
    { set gm:cls=paved_path }

# Грунтовая дорога: сначала tracktype (твёрдость), потом surface, без тегов — двухколейка
highway=track & gm:cls!=* & (tracktype=grade1 | tracktype=grade2) { set gm:cls=gravel }
highway=track & gm:cls!=* & tracktype=grade3 { set gm:cls=twintrack }
highway=track & gm:cls!=* & (tracktype=grade4 | tracktype=grade5) { set gm:cls=badtrack }
highway=track & gm:cls!=* & (surface=compacted | surface=fine_gravel) { set gm:cls=gravel }
highway=track & gm:cls!=* & (surface=ground | surface=grass | surface=sand | surface=dirt | surface=earth | surface=mud)
    { set gm:cls=badtrack }
highway=track & gm:cls!=* { set gm:cls=twintrack }

# Подземный переход показываем и в городе
highway=footway & tunnel=yes & gm:cls!=* { set gm:cls=path }

# Остальные footway — только вне города: целиком за пределами жилой застройки
highway=footway & gm:cls!=* & is_in(landuse,residential,none)=false { set gm:cls=none }

# Тропы. Подпись — оценка S из mtb:scale (берётся первая цифра: «1+» -> S1)
(highway=path | highway=footway) & gm:cls!=* & mtb:scale ~ '[2-6].*'
    { set gm:cls=hardpath; name 'S${mtb:scale|substring:"0:1"}' }
(highway=path | highway=footway) & gm:cls!=* & mtb:scale ~ '[01].*'
    { set gm:cls=path; name 'S${mtb:scale|substring:"0:1"}' }
(highway=path | highway=footway) & gm:cls!=* { set gm:cls=path }

# Строится: только будущие автомобильные дороги
highway=construction & gm:cls!=*
  & construction!=footway & construction!=path & construction!=cycleway & construction!=steps
  & construction!=track & construction!=pedestrian & construction!=bridleway & construction!=platform
    { set gm:cls=construction }

# --- Признаки: мост, тоннель ---
highway=* & bridge=* & bridge!=no { set gm:br=yes }
highway=* & tunnel=yes { set gm:tun=yes }

# Стрелок одностороннего движения и стрелок на съездах нет: рябят (решение заказчика).

# ---------------------------------------------------------------------------
# 2. Накладки: рисуются вместе с дорогой (continue)
# ---------------------------------------------------------------------------

# Маршруты из отношений. Теги gm:bike и gm:mtb ставит файл relations.
# Пунктир веломаршрута идёт с одной стороны линии, точки МТБ-маршрута —
# с другой. У широких дорог отступ больше, иначе накладка спряталась бы
# под дорогой.
(gm:bike=yes | gm:mtb=yes) & (gm:cls=primary | gm:cls=secondary | gm:cls=green_wide) { set gm:off=far }

gm:bike=yes & gm:off!=far [0x11701 resolution 22-22 continue]
gm:bike=yes & gm:off!=far [0x11301 resolution 23-23 continue]
gm:bike=yes & gm:off!=far [0x10f01 resolution 24 continue]
gm:bike=yes & gm:off=far  [0x11702 resolution 22-22 continue]
gm:bike=yes & gm:off=far  [0x11302 resolution 23-23 continue]
gm:bike=yes & gm:off=far  [0x10f02 resolution 24 continue]

gm:mtb=yes & gm:off!=far [0x11303 resolution 23-23 continue]
gm:mtb=yes & gm:off!=far [0x10f03 resolution 24 continue]
gm:mtb=yes & gm:off=far  [0x11304 resolution 23-23 continue]
gm:mtb=yes & gm:off=far  [0x10f04 resolution 24 continue]

# Государственная граница (тег gm:border ставит relations)
gm:border=yes [0x11c01 resolution 18 continue]
boundary=administrative & admin_level=2 & gm:border!=yes [0x11c01 resolution 18 continue]

# Паром
route=ferry [0x11c00 resolution 18 continue]

# ---------------------------------------------------------------------------
# 3. Тоннели: с 3-го экрана, осветлённые, с пунктирной обводкой.
#    На экранах 1–2 тоннели не рисуются: на поверхности их нет.
# ---------------------------------------------------------------------------
gm:tun=yes & gm:cls=green_wide [0x11016 resolution 23-23 continue]
gm:tun=yes & gm:cls=green_wide [0x10c16 resolution 24]
gm:tun=yes & gm:cls=green_link [0x11015 resolution 23-23 continue]
gm:tun=yes & gm:cls=green_link [0x10c15 resolution 24]
gm:tun=yes & gm:cls=primary    [0x11014 resolution 23-23 continue]
gm:tun=yes & gm:cls=primary    [0x10c14 resolution 24]
gm:tun=yes & gm:cls=secondary  [0x11013 resolution 23-23 continue]
gm:tun=yes & gm:cls=secondary  [0x10c13 resolution 24]
gm:tun=yes & gm:cls=tertiary   [0x11012 resolution 23-23 continue]
gm:tun=yes & gm:cls=tertiary   [0x10c12 resolution 24]
gm:tun=yes & (gm:cls=street | gm:cls=noaccess) [0x11010 resolution 23-23 continue]
gm:tun=yes & (gm:cls=street | gm:cls=noaccess) [0x10c10 resolution 24]

# Подземный переход, тропа или велодорожка в тоннеле: белый пунктир поверх дорог
gm:tun=yes & (gm:cls=path | gm:cls=hardpath | gm:cls=paved_path | gm:cls=cycleway | gm:cls=steps)
    [0x11305 resolution 23-23 continue]
gm:tun=yes & (gm:cls=path | gm:cls=hardpath | gm:cls=paved_path | gm:cls=cycleway | gm:cls=steps)
    [0x10f05 resolution 24]

# ---------------------------------------------------------------------------
# 4. Мосты: с 3-го экрана, та же линия с тёмными бортиками, поверх остальных.
#    Обычная линия под мостом тоже рисуется (continue).
# ---------------------------------------------------------------------------
gm:br=yes & gm:cls=green_wide [0x11216 resolution 23-23 continue]
gm:br=yes & gm:cls=green_wide [0x10e16 resolution 24 continue]
gm:br=yes & gm:cls=green_link [0x11215 resolution 23-23 continue]
gm:br=yes & gm:cls=green_link [0x10e15 resolution 24 continue]
gm:br=yes & gm:cls=primary    [0x11214 resolution 23-23 continue]
gm:br=yes & gm:cls=primary    [0x10e14 resolution 24 continue]
gm:br=yes & gm:cls=secondary  [0x11213 resolution 23-23 continue]
gm:br=yes & gm:cls=secondary  [0x10e13 resolution 24 continue]
gm:br=yes & gm:cls=tertiary   [0x11212 resolution 23-23 continue]
gm:br=yes & gm:cls=tertiary   [0x10e12 resolution 24 continue]
gm:br=yes & gm:cls=street     [0x11210 resolution 23-23 continue]
gm:br=yes & gm:cls=street     [0x10e10 resolution 24 continue]
gm:br=yes & gm:cls=cycleway   [0x11218 resolution 23-23 continue]
gm:br=yes & gm:cls=cycleway   [0x10e18 resolution 24 continue]
gm:br=yes & (gm:cls=gravel | gm:cls=twintrack) [0x1120a resolution 23-23 continue]
gm:br=yes & (gm:cls=gravel | gm:cls=twintrack) [0x10e0a resolution 24 continue]

# Пешеходный мостик: тропа с бортиками
gm:br=yes & (gm:cls=path | gm:cls=hardpath | gm:cls=paved_path | gm:cls=badtrack | gm:cls=steps)
    [0x11205 resolution 23-23 continue]
gm:br=yes & (gm:cls=path | gm:cls=hardpath | gm:cls=paved_path | gm:cls=badtrack | gm:cls=steps)
    [0x10e05 resolution 24 continue]

# ---------------------------------------------------------------------------
# 5. Классы -> типы Garmin по ступеням толщины
# ---------------------------------------------------------------------------

# Автомагистраль и большие дороги с запретом: с обзорного экрана
gm:cls=green_wide [0x11916 resolution 18-21 continue]
gm:cls=green_wide [0x11516 resolution 22-22 continue]
gm:cls=green_wide [0x11116 resolution 23-23 continue]
gm:cls=green_wide [0x10d16 resolution 24]

# Съезды и дороги для автомобилей помельче
gm:cls=green_link [0x11915 resolution 21-21 continue]
gm:cls=green_link [0x11515 resolution 22-22 continue]
gm:cls=green_link [0x11115 resolution 23-23 continue]
gm:cls=green_link [0x10d15 resolution 24]

# Дорога I класса
gm:cls=primary [0x11914 resolution 18-21 continue]
gm:cls=primary [0x11514 resolution 22-22 continue]
gm:cls=primary [0x11114 resolution 23-23 continue]
gm:cls=primary [0x10d14 resolution 24]

# Дорога II класса
gm:cls=secondary [0x11913 resolution 19-21 continue]
gm:cls=secondary [0x11513 resolution 22-22 continue]
gm:cls=secondary [0x11113 resolution 23-23 continue]
gm:cls=secondary [0x10d13 resolution 24]

# Дорога III класса, местная
gm:cls=tertiary [0x11912 resolution 20-21 continue]
gm:cls=tertiary [0x11512 resolution 22-22 continue]
gm:cls=tertiary [0x11112 resolution 23-23 continue]
gm:cls=tertiary [0x10d12 resolution 24]

# Улица, проезд: со 2-го экрана
gm:cls=street [0x11510 resolution 22-22 continue]
gm:cls=street [0x11110 resolution 23-23 continue]
gm:cls=street [0x10d10 resolution 24]

# Велодорожка: со 2-го экрана, поверх дорог
gm:cls=cycleway [0x11518 resolution 22-22 continue]
gm:cls=cycleway [0x11118 resolution 23-23 continue]
gm:cls=cycleway [0x10d18 resolution 24]

# Хорошая гравийка: со 2-го экрана
gm:cls=gravel [0x1150a resolution 22-22 continue]
gm:cls=gravel [0x1110a resolution 23-23 continue]
gm:cls=gravel [0x10d0a resolution 24]

# Двухколейка: со 2-го экрана
gm:cls=twintrack [0x11509 resolution 22-22 continue]
gm:cls=twintrack [0x11109 resolution 23-23 continue]
gm:cls=twintrack [0x10d09 resolution 24]

# Асфальтовая дорожка, плохой грунт, тропы: с 3-го экрана
gm:cls=paved_path [0x11108 resolution 23-23 continue]
gm:cls=paved_path [0x10d08 resolution 24]
gm:cls=badtrack [0x11104 resolution 23-23 continue]
gm:cls=badtrack [0x10d04 resolution 24]
gm:cls=hardpath [0x11106 resolution 23-23 continue]
gm:cls=hardpath [0x10d06 resolution 24]
gm:cls=path [0x11105 resolution 23-23 continue]
gm:cls=path [0x10d05 resolution 24]

# Пешеходная зона и лестница: с 4-го экрана
gm:cls=pedestrian [0x10d0f resolution 24]
gm:cls=steps [0x10d07 resolution 24]

# Проезд запрещён: с 3-го экрана. Две линии: серая подложка и белая
# с красными точками поверх (в одном типе TYP три цвета не помещаются).
gm:cls=noaccess [0x1110d resolution 23-23 continue]
gm:cls=noaccess [0x1110e resolution 23-23 continue]
gm:cls=noaccess [0x10d0d resolution 24 continue]
gm:cls=noaccess [0x10d0e resolution 24]

# Дорога строится: с 3-го экрана. Тоже две линии: серые штрихи и белые поверх.
gm:cls=construction [0x1110b resolution 23-23 continue]
gm:cls=construction [0x1110c resolution 23-23 continue]
gm:cls=construction [0x10d0b resolution 24 continue]
gm:cls=construction [0x10d0c resolution 24]

# ---------------------------------------------------------------------------
# 6. Рельсы
# ---------------------------------------------------------------------------

# Трамвайные пути не показываем (решение заказчика).

# Подъездные и станционные пути: только крупно
railway=rail & tunnel!=yes & service=* [0x11103 resolution 23-23 continue]
railway=rail & tunnel!=yes & service=* [0x10d03 resolution 24]

railway=rail & tunnel!=yes [0x11903 resolution 18-21 continue]
railway=rail & tunnel!=yes [0x11503 resolution 22-22 continue]
railway=rail & tunnel!=yes [0x11103 resolution 23-23 continue]
railway=rail & tunnel!=yes [0x10d03 resolution 24]

# ---------------------------------------------------------------------------
# 7. Вода
# ---------------------------------------------------------------------------

# Река: с обзорного экрана; канал — с масштаба ~2 км
waterway=river & tunnel!=* [0x11901 resolution 18-21 continue]
waterway=canal & tunnel!=* [0x11901 resolution 20-21 continue]
(waterway=river | waterway=canal) & tunnel!=* [0x11501 resolution 22-22 continue]
(waterway=river | waterway=canal) & tunnel!=* [0x11101 resolution 23-23 continue]
(waterway=river | waterway=canal) & tunnel!=* [0x10d01 resolution 24]

# Пересыхающий ручей: синий пунктир, с 3-го экрана
waterway=stream & intermittent=yes & tunnel!=* [0x11102 resolution 23-23 continue]
waterway=stream & intermittent=yes & tunnel!=* [0x10d02 resolution 24]

# Ручей: с 3-го экрана
waterway=stream & tunnel!=* [0x11100 resolution 23-23 continue]
waterway=stream & tunnel!=* [0x10d00 resolution 24]
